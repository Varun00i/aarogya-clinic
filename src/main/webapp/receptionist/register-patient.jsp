<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>Register Patient | Aarogya Clinic</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body class="app"><div class="app-shell"><aside class="sidebar"><div class="brand"><img class="brand-mark" src="${pageContext.request.contextPath}/assets/css/logo.svg"><div class="brand-name">Aarogya Clinic<small>RECEPTION</small></div></div><a class="side-link" href="${pageContext.request.contextPath}/receptionist/dashboard.jsp">▦ <span>Dashboard</span></a><a class="side-link active" href="${pageContext.request.contextPath}/receptionist/register">+ <span>Register Patient</span></a><a class="side-link" href="${pageContext.request.contextPath}/receptionist/appointments.jsp">▣ <span>Appointments</span></a><a class="side-link" href="${pageContext.request.contextPath}/receptionist/queue.jsp">≡ <span>Today's Queue</span></a></aside><main class="main"><header class="app-header"><b>Reception Desk</b><a href="${pageContext.request.contextPath}/logout" style="font-size:13px;color:var(--muted)">Sign out</a></header><div class="app-content"><div class="page-heading"><div><div class="eyebrow">NEW PATIENT</div><h1>Patient registration</h1></div></div>
<c:if test="${not empty sessionScope.success}"><div class="alert-error" style="background:#edf7f2;border-color:#b8dac8;color:#246b4c" role="status"><c:out value="${sessionScope.success}"/></div><c:remove var="success" scope="session"/></c:if><c:if test="${not empty error}"><div class="alert-error" role="alert"><c:out value="${error}"/></div></c:if>
<form class="panel" method="post" action="${pageContext.request.contextPath}/receptionist/register" style="padding:22px"><div class="form-grid"><div class="form-group"><label>Full name *</label><input class="form-control" name="fullName" required></div><div class="form-group"><label>Guardian name</label><input class="form-control" name="guardianName"></div><div class="form-group"><label>Date of birth *</label><input class="form-control" type="date" name="dob" required></div><div class="form-group"><label>Gender *</label><select class="form-control" name="gender" required><option>Male</option><option>Female</option><option>Other</option></select></div><div class="form-group"><label>Mobile number *</label><input class="form-control" name="mobile" pattern="[6-9][0-9]{9}" maxlength="10" placeholder="9876543210" required></div><div class="form-group"><label>Email</label><input class="form-control" type="email" name="email"></div><div class="form-group full"><label>Address *</label><input class="form-control" name="address" required></div><div class="form-group"><label>City *</label><input class="form-control" name="city" value="Noida" required></div><div class="form-group"><label>State *</label><select class="form-control" name="state"><option>Uttar Pradesh</option><option>Delhi</option><option>Haryana</option><option>Rajasthan</option><option>Maharashtra</option><option>Karnataka</option></select></div><div class="form-group"><label>PIN code *</label><input class="form-control" name="pin" pattern="[0-9]{6}" required></div><div class="form-group"><label>Blood group</label><select class="form-control" name="bloodGroup"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div></div><button class="btn btn-primary">Register Patient</button></form></div></main></div></body></html>
