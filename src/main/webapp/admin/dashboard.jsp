<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>Admin Dashboard | Aarogya Clinic</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body class="app"><div class="app-shell">
<aside class="sidebar"><div class="brand"><img class="brand-mark" src="${pageContext.request.contextPath}/assets/css/logo.svg"><div class="brand-name">Aarogya Clinic<small>ADMIN PORTAL</small></div></div><a class="side-link active" href="${pageContext.request.contextPath}/admin/dashboard">▦ <span>Dashboard</span></a><a class="side-link" href="${pageContext.request.contextPath}/receptionist/patients.jsp">◫ <span>Patients</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/doctors.jsp">♙ <span>Doctors</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/departments.jsp">▥ <span>Departments</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/appointments.jsp">▣ <span>Appointments</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/reports.jsp">▤ <span>Reports</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/payments.jsp">₹ <span>Payments</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin/audit-logs.jsp">⌁ <span>Audit Logs</span></a></aside>
<main class="main"><header class="app-header"><div><b>Administration</b><div style="font-size:12px;color:var(--muted)">27 November 2026 · IST</div></div><a href="${pageContext.request.contextPath}/logout" style="font-size:13px;color:var(--muted)">Sign out</a></header><div class="app-content"><div class="page-heading"><div><div class="eyebrow">OVERVIEW</div><h1>Good morning, Aarav</h1></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/receptionist/register">+ Register Patient</a></div>
<div class="stats-grid"><div class="stat"><div class="stat-label">TOTAL PATIENTS</div><div class="stat-value">${empty totalPatients ? 0 : totalPatients}</div><div class="stat-note">Registered records</div></div><div class="stat"><div class="stat-label">TODAY'S APPOINTMENTS</div><div class="stat-value">${empty todayAppointments ? 0 : todayAppointments}</div><div class="stat-note">Across 6 departments</div></div><div class="stat"><div class="stat-label">WAITING PATIENTS</div><div class="stat-value">${empty waiting ? 0 : waiting}</div><div class="stat-note">In active queues</div></div><div class="stat"><div class="stat-label">AVAILABLE DOCTORS</div><div class="stat-value">${empty doctors ? 0 : doctors}</div><div class="stat-note">Ready to consult</div></div></div>
<div class="panel"><div class="panel-head"><h3>Today's appointment activity</h3><a href="${pageContext.request.contextPath}/admin/appointments.jsp" style="font-size:12px;color:var(--teal)">View all</a></div><div class="table-wrap"><table><thead><tr><th>Appointment</th><th>Patient</th><th>Doctor</th><th>Time</th><th>Status</th></tr></thead><tbody><tr><td>APT-2026-0001</td><td>Rahul Sharma</td><td>Dr. Amit Sharma</td><td>09:30 AM</td><td><span class="badge badge-amber">Waiting</span></td></tr><tr><td>APT-2026-0002</td><td>Priya Sharma</td><td>Dr. Amit Sharma</td><td>10:30 AM</td><td><span class="badge badge-amber">Waiting</span></td></tr><tr><td>APT-2026-0003</td><td>Rahul Sharma</td><td>Dr. Priya Verma</td><td>01:00 PM</td><td><span class="badge badge-blue">Scheduled</span></td></tr></tbody></table></div></div></div></main></div></body></html>
